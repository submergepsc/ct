        </property>
       </widget>
      </item>
      <item row="0" column="1">
       <widget class="QLineEdit" name="courseFileEdit"/>
      </item>
      <item row="0" column="2">
       <widget class="QPushButton" name="loadButton">
        <property name="text">
         <string>读取文件</string>
        </property>
       </widget>
      </item>
      <item row="1" column="0" colspan="3">
       <widget class="QTextEdit" name="courseInput">
        <property name="placeholderText">
